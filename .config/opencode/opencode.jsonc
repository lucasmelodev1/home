{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "code",
  "permission": {
    "skill": "allow"
  },
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true }
  },
  "mcp": {
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com",
      "enabled": true
    }
  }
}
